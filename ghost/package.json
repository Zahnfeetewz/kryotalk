  "description": "Ghost — Anonymous E2E Encrypted Messenger",
  "main": "src/electron.js",
  "scripts": {
    "build": "esbuild src/client/app.js --bundle --outfile=static/app.js --format=iife --target=es2020 --define:global=globalThis --inject:./src/client/shim.js",
